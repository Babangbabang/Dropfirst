# PayPal Sandbox credentials — get these free at https://developer.paypal.com/
# Dashboard > Apps & Credentials > Sandbox > your app > Client ID / Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Currency used for the demo (PayPal does not support IDR; see README)
CURRENCY=USD

# Optional: wire up a real AI provider for the agent endpoint.
# If left blank, the agent falls back to a simple rule-based picker
# so the app still works end-to-end without any AI key.
AI_PROVIDER=
AI_API_KEY=

PORT=3000
